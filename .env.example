RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace_me
# For local SSR only. Do not commit this JSON or a service-account file.
# Firebase/Google Cloud deployments use their attached service account automatically.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
# Easier local alternative: download a key from Firebase Console > Project settings
# > Service accounts, save it as service-account.json beside package.json, then use:
FIREBASE_SERVICE_ACCOUNT_FILE=./service-account.json
