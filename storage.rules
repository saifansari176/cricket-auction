rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isImageUnder5Mb() {
      return request.resource.size > 0
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Public pages render these images by URL, but cannot enumerate the bucket.
    match /{folder}/{fileName} {
      allow get: if folder in ['players', 'teams', 'auction'];
      allow create: if folder == 'players' && isImageUnder5Mb();
      allow create: if request.auth != null
        && folder in ['teams', 'auction']
        && isImageUnder5Mb();
      allow update, delete, list: if false;
    }
  }
}
