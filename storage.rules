rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{folder}/{fileName} {
      allow read: if true;
      // Player registration is a public form, so its photo upload is allowed
      // without sign-in; type and size are still enforced.
      allow write: if (request.auth != null || folder == 'players')
        && folder in ['players', 'teams', 'auction']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
